rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace PUT_ADMIN_UID_HERE with your own Firebase user UID (Authentication > Users).
    function isAdmin() { return request.auth != null && request.auth.uid == 'PUT_ADMIN_UID_HERE'; }

    match /listings/{id} {
      allow read: if resource.data.status == 'live'
                  || (request.auth != null && resource.data.uid == request.auth.uid)
                  || isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.fe == 0 && request.resource.data.vf == 0
                    && request.resource.data.t is string && request.resource.data.t.size() >= 3 && request.resource.data.t.size() <= 120
                    && request.resource.data.p is number && request.resource.data.p > 0
                    && request.resource.data.n.size() <= 400;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    match /sellers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
  }
}
